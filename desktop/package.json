{
  "name": "design-alarm",
  "productName": "(주)휴즈랩 디자인",
  "version": "1.0.9",
  "description": "(주)휴즈랩 디자인 — 디자인 작업 요청·현황판 + 새 소식 알림",
  "author": "HUEZLAB",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.huezlab.designalarm",
    "productName": "(주)휴즈랩 디자인",
    "artifactName": "huezlab-design-setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "desk-preload.js",
      "shell.html",
      "config.json",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "(주)휴즈랩 디자인",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://huezlab-co.github.io/design-alarm/update/"
      }
    ]
  }
}